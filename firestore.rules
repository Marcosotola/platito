rules_version = '2';

// La carta es pública para leer; sólo los usuarios dados de alta en la
// colección `admins` (documento con su UID) pueden modificarla.
service cloud.firestore {
  match /databases/{database}/documents {
    function esAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /menus/{id} {
      allow read: if true;
      allow write: if esAdmin();
    }
    match /categorias/{id} {
      allow read: if true;
      allow write: if esAdmin();
    }
    match /productos/{id} {
      allow read: if true;
      allow write: if esAdmin();
    }
    match /configuracion/{id} {
      allow read: if true;
      allow write: if esAdmin();
    }
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false; // se cargan a mano desde la consola
    }
  }
}
